# Database (MySQL local via docker-compose)
DATABASE_URL="mysql://root:rootpassword@localhost:3306/gym"

# Auth (JWT in httpOnly cookies)
JWT_ACCESS_SECRET="change_me_access_secret_at_least_32_chars_long"
JWT_REFRESH_SECRET="change_me_refresh_secret_at_least_32_chars_long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"

# CORS
CORS_ORIGIN="http://localhost:5173"

# SMTP (for password reset emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM='"GYM" <noreply@gym.com>'

# Server
PORT=3000
NODE_ENV="development"